# Copy to .env and load with node --env-file=.env src/server.js
# Never commit your real credentials.
XAI_API_KEY=replace-with-xai-api-key
APP_ACCESS_TOKEN=replace-with-a-long-random-access-token-32-chars-minimum
XAI_MODEL=grok-4.7
PORT=8787
HOST=0.0.0.0

# Exact HTTPS origins allowed to connect from browsers, comma-separated if needed.
ALLOWED_ORIGIN=https://hostkris.github.io
